# --- Analysis provider (need ONE of the two below) ---

# Option A: direct Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides:
# CLAUDE_MODEL=claude-opus-4-8
# ANALYSIS_EFFORT=medium            # low | medium | high | xhigh | max

# Option B: OpenRouter (OpenAI-compatible gateway to Claude models).
# Used automatically when ANTHROPIC_API_KEY is not set.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5   # any Claude slug on OpenRouter
# OPENROUTER_SITE_URL=https://your-app.vercel.app  # optional attribution
# OPENROUTER_APP_TITLE=MeetingAction               # optional attribution

# Shared:
# ANALYSIS_MAX_TOKENS=8000

# --- HTTP / CORS ---
# Comma-separated allowed origins, or * for all (dev default).
# CORS_ORIGINS=https://your-app.vercel.app
# MAX_TRANSCRIPT_CHARS=200000

# --- Optional: audio transcription (OpenAI Whisper) ---
# OPENAI_API_KEY=sk-...
# TRANSCRIPTION_MODEL=whisper-1

# --- Optional: Jira export ---
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=...
# JIRA_PROJECT_KEY=MEET
# JIRA_ISSUE_TYPE=Task

# --- Optional: Notion export ---
# NOTION_API_KEY=secret_...
# NOTION_DATABASE_ID=...
