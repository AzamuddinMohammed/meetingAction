# --- Core: Claude (required for analysis) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides:
# CLAUDE_MODEL=claude-opus-4-8
# ANALYSIS_EFFORT=medium            # low | medium | high | xhigh | max
# ANALYSIS_MAX_TOKENS=8000

# --- HTTP / CORS ---
# Comma-separated allowed origins, or * for all (dev default).
# CORS_ORIGINS=https://your-app.vercel.app
# MAX_TRANSCRIPT_CHARS=200000

# --- Optional: audio transcription (OpenAI Whisper) ---
# OPENAI_API_KEY=sk-...
# TRANSCRIPTION_MODEL=whisper-1

# --- Optional: Jira export ---
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=...
# JIRA_PROJECT_KEY=MEET
# JIRA_ISSUE_TYPE=Task

# --- Optional: Notion export ---
# NOTION_API_KEY=secret_...
# NOTION_DATABASE_ID=...
